<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <AssemblyName>hexusd</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hexus.Configuration\Hexus.Configuration.csproj" />

        <PackageReference Include="EndpointMapper" Version="2.0.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
          <!-- Workaround for: https://github.com/dotnet/sdk/issues/29974: we can't use all as it won't publish the hexusd.deps.json. We are still specifying all assets -->
          <PrivateAssets>compile; runtime; contentFiles; build; buildTransitive; analyzers; native</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NReco.Logging.File" Version="1.4.0" />
        <PackageReference Include="Tomlyn" Version="2.10.1" />
    </ItemGroup>
</Project>
